/* Responsive Design for All Agent Sections */
@media (max-width: 768px) {
  .agent-hero {
    flex-direction: column;
    gap: 1rem;
  }
  
  .agent-hero-content h1 {
    font-size: 2rem;
  }
  
  .agent-subtitle {
    font-size: 1.125rem;
  }
  
  .backlog-content,
  .daily-standup-content,
  .risk-dependency-content {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  .backlog-nav,
  .daily-standup-nav,
  .risk-dependency-nav {
    position: static;
  }
  
  .scoring-details {
    grid-template-columns: 1fr;
  }
  
  .metrics-grid,
  .capability-grid,
  .feature-grid,
  .outcome-grid {
    grid-template-columns: 1fr;
  }
  
  .backlog-outcome-section,
  .daily-standup-outcome-section,
  .risk-dependency-outcome-section {
    margin: 2rem -1.5rem -1.5rem -1.5rem;
    padding: 2rem 1.5rem;
  }
  
  .benefit {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }
  
  .daily-standup-outcome-section .outcome-benefits {
    grid-template-columns: 1fr;
  }
  
  .phase-header {
    padding: 1rem 1.5rem;
  }
  
  .phase-steps {
    padding: 1.5rem;
  }
  
  .importance-callout {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }
  
  .feature-item {
    padding: 1.5rem;
  }
  
  .outcome-card {
    padding: 1.5rem;
  }
}

