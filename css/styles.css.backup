    position: static;
  }
  
  .risk-dependency-outcome-section {
    margin: 2rem -1.5rem -1.5rem -1.5rem;
    padding: 2rem 1.5rem;
  }
  
  .importance-callout {
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }
}
